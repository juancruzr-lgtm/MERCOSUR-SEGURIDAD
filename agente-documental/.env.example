# ─── Supabase ────────────────────────────────────────────────
# Usar siempre service_role. Nunca la anon key.
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# ─── Identidad del agente ────────────────────────────────────
# Debe ser único por máquina. Ejemplos: notebook-juan, servidor-mpls
DOCUMENT_AGENT_ID=notebook-juan

# Origen lógico del documento. En v1 siempre "local".
# Futuro: local | sharepoint | mega | email | google-drive
DOCUMENT_SOURCE=local

# Empresa propietaria de los documentos (para soporte multi-empresa futuro)
DOCUMENT_EMPRESA=mercosur-seguridad

# ─── Carpeta observada ───────────────────────────────────────
# Ruta absoluta de la carpeta raíz. Nunca queda fija en el código.
# Windows: C:\Users\juan\Documentos\MercosurDocs
# Servidor: D:\Documentos
DOCUMENT_ROOT_PATH=

# ─── Filtros ─────────────────────────────────────────────────
# Tamaño máximo de archivo en MB (default: 50)
DOCUMENT_MAX_SIZE_MB=50

# Carpetas a ignorar, separadas por coma (sin espacios)
# Ejemplo: temp,cache,borradores,privado
DOCUMENT_IGNORE=

# ─── Logging ─────────────────────────────────────────────────
# debug | info | warn | error  (default: info)
AGENT_LOG_LEVEL=info
