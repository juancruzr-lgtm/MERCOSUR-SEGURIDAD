# Copiá este archivo como .env.local y completá con tus datos de Supabase
# Los encontrás en: Supabase → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
ANTHROPIC_API_KEY=TU_API_KEY_DE_ANTHROPIC
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:administracion@mercosurseguridad.com.ar
CRON_SECRET=UN_SECRETO_LARGO_PARA_CRON
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI
IA_CRON_SECRET=UN_SECRETO_LARGO_SOLO_PARA_EL_CRON_DE_IA

# ARCA — Facturación (WSFE). Producción usa AFIP_CERT_PEM / AFIP_KEY_PEM / AFIP_CUIT_REPRESENTADA (los mismos del Padrón A13).
# Homologación tiene credenciales propias; nunca usa las productivas. No poner AFIP_HOMO=1 (afecta Padrón A13 y legajo).
AFIP_HOMO_CERT_PEM=
AFIP_HOMO_KEY_PEM=
AFIP_HOMO_CUIT_REPRESENTADA=
# Segunda llave de la emisión REAL (la primera es fact_config.emision.produccion_habilitada). Dejar sin definir.
# FACTURACION_EMISION_REAL=
